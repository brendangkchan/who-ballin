{
  "name": "who-ballin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.21.1"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_execpath || !process.env.npm_execpath.includes('pnpm')) { console.error('Use pnpm instead of npm.'); process.exit(1); }\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build-map": "tsx scripts/fetch-nba-player-ids.ts",
    "fill-map": "tsx scripts/fill-missing-nba-ids.ts",
    "apply-manual-ids": "tsx scripts/apply-manual-nba-ids.ts",
    "revalidate": "node scripts/revalidate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "backfill:season": "tsx scripts/backfill-season.ts",
    "db:check": "tsx scripts/check-db.ts",
    "sandbox:check": "bash scripts/sandbox-setup.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.0",
    "nba-color": "^1.4.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "pg": "^8.13.1",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
